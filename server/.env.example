# Admin CMS server configuration
PORT=3000
# Absolute or relative path to the public website root (served at /)
# "." = the site folder that contains this server/ directory
PUBLIC_ROOT=.
# SQLite database file path
DB_PATH=./data/cms.db
# Secret used to sign auth tokens / sessions
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=CHANGE_ME_to_a_long_random_string
# Comma-separated list of allowed admin email addresses (optional)
ADMIN_EMAILS=
# Set to run behind a reverse proxy / HTTPS
TRUST_PROXY=false
# New uploads max size in bytes
MAX_IMAGE_MB=10
MAX_VIDEO_MB=250